    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
